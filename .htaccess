AddDefaultCharset utf-8
ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes
<FilesMatch "^(config|lib)\.php$">
Require all denied
</FilesMatch>
RewriteEngine On
# продление SSL-сертификата: не перенаправлять
RewriteRule ^\.well-known/acme-challenge/ - [L]
# https (хостинг за прокси: смотрим заголовок X-Forwarded-Proto)
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# www -> без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
# старые адреса сайта на Tilda -> новые страницы (301)
RewriteRule ^terms/?$ https://%{HTTP_HOST}/offer [R=301,L]
RewriteRule ^pr/?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^dry-body-oils/?$ https://%{HTTP_HOST}/#catalog [R=301,L,NE]
RewriteRule ^how-to/?$ https://%{HTTP_HOST}/#catalog [R=301,L,NE]
RewriteRule ^tproduct/ https://%{HTTP_HOST}/#catalog [R=301,L,NE]
# прежние страницы магазина
RewriteRule ^assort(\.html)?/?$ https://%{HTTP_HOST}/#catalog [R=301,L,NE]
RewriteRule ^ritual(\.html)?/?$ https://%{HTTP_HOST}/nabor [R=301,L]
# упрощённая версия без подносов (убрать строку, когда вернётся страница /trays)
RewriteRule ^trays(\.html)?/?$ https://%{HTTP_HOST}/ [R=302,L]
RewriteRule ^tpost/ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^blog/? https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^page[0-9]+\.html$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^(sitemap-feeds|sitemap-store)\.xml$ - [G,L]
# старые адреса с .html -> чистые адреса (301)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
# убрать слэш в конце
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]
# адреса без .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
AddType video/webm .webm
AddType image/webp .webp
AddType image/svg+xml .svg
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType video/webm "access plus 30 days"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
